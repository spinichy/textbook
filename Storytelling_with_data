  Category = rep(c("Health", "Education", "Human services", "Arts & culture", "Other"), each = length(years)),
  Percent = c(
    67, 53, 61, 65, 70, 75,  # Health
    73, 80, 74, 70, 63, 60,  # Education
    60, 85, 78, 60, 58, 55,  # Human services
    20, 25, 28, 42, 30, 43,  # Arts & culture
    53, 30, 45, 30, 45, 30   # Other
  )
)

categories <- c("Health", "Education", "Human services", "Arts & culture", "Other")

# 2. Function to create each vertical column plot (with short year labels and compact margins)
create_col_plot <- function(cat_name, show_yaxis = FALSE, highlight_pct_end = FALSE) {
  cat_data <- df %>% filter(Category == cat_name)
  start_val <- cat_data %>% filter(Year == 2010) %>% pull(Percent)
  end_val <- cat_data %>% filter(Year == 2015) %>% pull(Percent)
  
  p <- ggplot(cat_data, aes(x = Year, y = Percent)) +
    # Trend line and endpoints
    geom_line(color = "#2b7bde", linewidth = 1.2) +
    geom_point(data = subset(cat_data, Year %in% c(2010, 2015)), color = "#2b7bde", size = 2.5) +
    
    # Optional start/end percentage labels
    { if (highlight_pct_end) 
      geom_text(data = subset(cat_data, Year == 2015), aes(label = paste0(end_val, "%")), hjust = -0.3, vjust = 0.5, color = "#2b7bde", size = 3.5, fontface = "bold") } +
    
    # Scales using short year labels mapped via labels parameter
    scale_y_continuous(
      limits = c(0, 100), 
      breaks = seq(0, 100, by = 10), 
      labels = if (show_yaxis) paste0(seq(0, 100, by = 10), "%") else NULL, 
      expand = c(0, 0)
    ) +
    scale_x_continuous(breaks = years, labels = short_years, limits = c(2009.2, 2015.8), expand = c(0, 0)) +
    
    # Minimal theme styling with minimal horizontal margins to eliminate gaps between plots
    theme_minimal(base_family = "sans") +
    theme(
      plot.title = element_blank(),
      axis.title = element_blank(),
      # Conditionally show or hide Y-axis text, ticks, and line
      axis.text.y = if (show_yaxis) element_text(size = 9, color = "#555555") else element_blank(),
      axis.ticks.y = if (show_yaxis) element_line(color = "#cccccc") else element_blank(),
      axis.line.y = if (show_yaxis) element_line(color = "#cccccc", linewidth = 0.6) else element_blank(),
      
      axis.text.x = element_text(size = 9, color = "#555555", angle = 0, hjust = 0.5),
      axis.ticks.x = element_blank(),
      axis.line.x = element_line(color = "#cccccc", linewidth = 0.6),
      axis.ticks = element_blank(),
      panel.grid.major = element_blank(),
      panel.grid.minor = element_blank(),
      plot.margin = margin(10, 15, 10, 30) # Minimized left/right margins for tight spacing between panels
    )
  
  return(p)
}

