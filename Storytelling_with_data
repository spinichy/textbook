  mutate(x_pos = product_offsets[as.character(Product)] + (Year - 2008))

# 3. Automatically align product labels precisely under each product's starting year (min x_pos)
product_labels <- df_clean %>%
  group_by(Product) %>%
  summarise(x_pos = min(x_pos))

# 4. Define start/end year annotations with customized downward nudge for 2010 and 2013
annotations <- df_clean %>%
  group_by(Product) %>%
  filter(Year == min(Year) | Year == max(Year)) %>%
  ungroup() %>%
  mutate(
    nudge_y_val = case_when(
      Year %in% c(2010, 2011,2013) ~ -25, # Push 2010 and 2013 further down
      Year == min(Year) ~ -20,       # Other start years
      TRUE ~ 0                       # End years (2014)
