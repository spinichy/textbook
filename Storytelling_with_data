p <- ggplot(df_long, aes(x = timing, y = percentage, group = response, color = response)) +
  geom_line(linewidth = 1.3, lineend = "round", linejoin = "round", antialias = TRUE) +
  geom_point(size = 3) +
  # Add text labels directly to the points (left side offset for BEFORE, right side offset for AFTER)
  geom_text(
    aes(label = paste0(percentage, "%"), 
        hjust = ifelse(timing == "BEFORE", 1.3, -0.3)),
    size = 4,
    fontface = "bold",
    show.legend = FALSE
  ) +
  scale_color_manual(values = color_palette) +
  # Extend y-axis limits slightly to prevent text labels from getting clipped
  scale_y_continuous(limits = c(0, 48), breaks = seq(0, 40, by = 10)) +
  # Extend x-axis expansion to give enough breathing room for text labels on both ends
  scale_x_discrete(expand = expansion(add = c(0.3, 0.4))) +
  theme_minimal(base_family = "sans") +
  theme(
    panel.grid.major = element_blank(),
    panel.grid.minor = element_blank(),
    legend.position = "none",
    axis.title = element_blank(),
    axis.text.y = element_blank(),
    axis.text.x = element_text(face = "bold", size = 12, color = "#777777"),
    axis.ticks = element_blank(),
    plot.margin = margin(t = 10, r = 20, b = 10, l = 20)
  )

