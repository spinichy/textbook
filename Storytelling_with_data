## 100% Stacked Horizontal Bar Chart
#-------------------------------------------------------------------------------



# Load required libraries
library(ggplot2)
library(dplyr)
library(tidyr)

# Use the built-in HairEyeColor dataset and convert it into a data frame
data("HairEyeColor")
hair_data <- as.data.frame(HairEyeColor)

# Aggregate and calculate proportions (display all percentages without filtering)
survey_real_data <- hair_data %>%
  group_by(Eye, Hair) %>%
  summarise(Count = sum(Freq), .groups = "drop") %>%
  group_by(Eye) %>%
  mutate(
    Proportion = Count / sum(Count),
    Percent_Label = paste0(round(Proportion * 100, 0), "%")
  ) %>%
  ungroup()

# Rename columns for clarity
colnames(survey_real_data)[1:2] <- c("Feature", "Rating")

# Create the 100% stacked horizontal bar chart with text labels using ggplot2
ggplot(survey_real_data, aes(x = reorder(Feature, Proportion), y = Proportion, fill = Rating)) +
  # Use position = "fill" to scale bars to 100%
  geom_bar(stat = "identity", position = "fill", width = 0.7) +
  # Add percentage text labels inside the bars for all segments
  geom_text(aes(label = Percent_Label), 
            position = position_fill(vjust = 0.5), 
            color = "white", fontface = "bold", size = 4) +
  # Flip coordinates to make it horizontal
  coord_flip() +
  # Format y-axis as percentage
  scale_y_continuous(labels = scales::percent_format()) +
  # Apply a clean color palette
  scale_fill_brewer(palette = "Set2") +
  # Apply a minimal theme
  theme_minimal() +
  # Add title, axis labels, legend, and source caption
  labs(
    title = "Eye Color Distribution with All Proportions",
    x = "Eye Color Category",
    y = "Percentage",
    fill = "Hair Rating",
    caption = "Source: R built-in HairEyeColor dataset"
  ) +
  # Customize theme elements
  theme(
    plot.title = element_text(hjust = 0.5, face = "bold", size = 16, 
                              margin = margin(t = 20, b = 15)),
    plot.caption = element_text(hjust = 1, size = 9, color = "gray40", face = "italic",
                                margin = margin(t = -5, r = 5)),
    plot.margin = unit(c(1, 1, 1, 1), "cm"),
    legend.position = "bottom",
    panel.grid.major.y = element_blank()
  )



