# Load required libraries
library(ggplot2)
library(dplyr)
library(tidyr)
library(patchwork)
library(cowplot) # Required for precise canvas-level label positioning

# 1. Create survey dataset
survey_data <- data.frame(
  Response = factor(
    c("Bored", "Not great", "OK", "Kind of interested", "Excited"),
    levels = c("Bored", "Not great", "OK", "Kind of interested", "Excited")
  ),
  Before = c(11, 5, 40, 25, 19),
  After = c(12, 6, 14, 30, 38)
)

# Colors matching the survey categories
response_colors <- c(
  "Bored" = "#4B89DC", 
  "Not great" = "#D9534F", 
  "OK" = "#92C556", 
  "Kind of interested" = "#8869B3", 
  "Excited" = "#3BABC9"
)

# 2. Top Pie Chart: PRE (Title included, percentage labels added)
p_pre <- ggplot(survey_data, aes(x = "", y = Before, fill = Response)) +
  geom_bar(stat = "identity", width = 1, color = "white") +
  coord_polar("y", start = 0) +
  geom_text(aes(label = paste0(Before, "%")), 
            position = position_stack(vjust = 0.5), 
            size = 3, color = "white", fontface = "bold") +
  scale_fill_manual(values = response_colors) +
  labs(title = "PRE: How do you feel\nabout doing science?") +
  theme_void() +
  theme(
    plot.title = element_text(hjust = 0.5, face = "bold", size = 15, color = "#333333"),
    legend.position = "none" # Hide individual legend
  )

# 3. Bottom Pie Chart: POST (Title included, percentage labels added)
p_post <- ggplot(survey_data, aes(x = "", y = After, fill = Response)) +
  geom_bar(stat = "identity", width = 1, color = "white") +
  coord_polar("y", start = 0) +
  geom_text(aes(label = paste0(After, "%")), 
            position = position_stack(vjust = 0.5), 
            size = 3, color = "white", fontface = "bold") +
  scale_fill_manual(values = response_colors) +
  labs(title = "POST: How do you feel\nabout doing science?") +
  theme_void() +
  theme(
    plot.title = element_text(hjust = 0.5, face = "bold", size = 15, color = "#333333"),
    legend.position = "none" # Hide individual legend
  )

# Combine left pie charts vertically and collect a single shared legend
left_pies <- (p_pre / p_post) + 
  plot_layout(guides = "collect") & 
  theme(
    legend.position = "bottom",
    legend.title = element_blank(),
    legend.text = element_text(size = 8)
  )

# 4. Prepare long-format data for the bar chart
survey_long <- survey_data %>%
  pivot_longer(
    cols = c(Before, After),
    names_to = "Timing",
    values_to = "Percentage"
  ) %>%
  mutate(
    Timing = factor(Timing, levels = c("Before", "After"))
  )

# 5. Right Plot: Storytelling Bar Chart (Both BEFORE/AFTER text aligned at y = 43)
p_bar <- ggplot(survey_long, aes(x = Response, y = Percentage, fill = Timing)) +
  geom_col(position = "dodge", width = 0.65) +
  geom_text(
    aes(label = paste0(Percentage, "%")), 
    position = position_dodge(0.65), 
    vjust = -0.5, 
    size = 3,
    fontface = "bold"
  ) +
  # Place both text annotations on the exact same baseline level (y = 43)
  annotate("text", x = 1.5, y = 46, size = 4, 
           label = "BEFORE program, the\nmajority of children felt\njust OK about science.", 
           hjust = 0.5, size = 3.1, fontface = "bold", color = "#333333") +
  annotate("text", x = 3.5, y = 46, size = 5,
           label = "AFTER program,\nmore children were\nKind of interested &\nExcited about science.", 
           hjust = 0, size = 3.1, fontface = "bold", color = "#2F75B5") +
  scale_fill_manual(values = c("Before" = "#999999", "After" = "#4A90E2")) +
  scale_y_continuous(limits = c(0, 58), breaks = seq(0, 40, 10)) +
  labs(
    title = "Pilot program was a success",
    subtitle = "How do you feel about science?",
    x = NULL,
    y = NULL,
    fill = NULL
  ) +
  theme_minimal(base_family = "sans") +
  theme(
    panel.grid.minor = element_blank(),
    panel.grid.major.x = element_blank(),
    plot.title = element_text(face = "bold", size = 12, color = "#333333"),
    plot.subtitle = element_text(size = 10, color = "#555555", margin = margin(b = 10)),
    legend.position = "none",
    axis.text.x = element_text(size = 9, face = "bold", color = "#333333"),
    axis.text.y = element_blank(),
    axis.ticks.y = element_blank()
  )

# 6. Combine Layouts: Left (Pies) | Right (Bar chart)
combined_plots <- left_pies | p_bar
combined_plots <- combined_plots + plot_layout(widths = c(0.9, 1.1))

# 7. Overlay 'Bad' and 'Good' precisely on the title baseline level using ggdraw
final_plot <- ggdraw(combined_plots) +
  draw_label("Bad", x = 0.35, y = 0.945, fontface = "bold", color = "#D9534F", size = 13, hjust = 1) +
  draw_label("Good", x = 0.965, y = 0.945, fontface = "bold", color = "#1F4E79", size = 13, hjust = 1)

# Print the final plot
print(final_plot)




