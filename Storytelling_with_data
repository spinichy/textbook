## Line Chart
#-------------------------------------------------------------------------------



# Load required libraries
library(ggplot2)
library(dplyr)
library(tidyr)

# Prepare a dataset with exactly 5 categories using the built-in 'diamonds' dataset
# We aggregate average price across different years or simulated time periods by 'cut' (5 categories)
set.seed(42)
trend_data <- diamonds %>%
  mutate(Year = sample(2010:2015, n(), replace = TRUE)) %>%
  group_by(Year, cut) %>%
  summarise(Average_Price = mean(price), .groups = "drop")

# Create the line chart using ggplot2
ggplot(trend_data, aes(x = Year, y = Average_Price, color = cut, group = cut)) +
  # Draw lines and points for 5 categories
  geom_line(linewidth = 1.2) +
  geom_point(size = 2.5) +
  # Apply a clean minimal theme
  theme_minimal() +
  # Add title, axis labels, legend, and source caption
  labs(
    title = "Diamond Price Trend by Cut (5 Categories)",
    x = "Year",
    y = "Average Price ($)",
    color = "Cut Quality",
    caption = "Source: ggplot2 diamonds dataset"
  ) +
  # Customize theme elements (title position, caption alignment, margins)
  theme(
    plot.title = element_text(hjust = 0.5, face = "bold", size = 16, 
                              margin = margin(t = 20, b = 15)),
    plot.caption = element_text(hjust = 1, size = 9, color = "gray40", face = "italic",
                                margin = margin(t = -5, r = 5)),
    plot.margin = unit(c(1, 1, 1, 1), "cm"),
    legend.position = "right",
    panel.grid.minor = element_blank()
  )



