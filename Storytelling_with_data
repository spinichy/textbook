# Load required libraries
library(ggplot2)
library(dplyr)
library(patchwork)
library(cowplot) # Required for ggdraw, draw_label, and geom_segment overlay

# 1. Prepare data for Top 10 Design Concerns
concerns_data <- data.frame(
  concern = c(
    "Engine power is less than expected",
    "Tires make excessive noise while driving",
    "Engine makes abnormal/excessive noise",
    "Seat material concerns",
    "Excessive wind noise",
    "Hesitation or delay when shifting",
    "Bluetooth system has poor sound quality",
    "Steering system/wheel has too much play",
    "Bluetooth system is difficult to use",
    "Front seat audio/entertainment/navigation controls"
  ),
  value = c(12.9, 12.3, 11.6, 11.6, 11.0, 10.3, 10.0, 8.8, 8.6, 8.2)
)

# Keep the original descending order for horizontal bar chart
concerns_data$concern <- factor(concerns_data$concern, levels = rev(concerns_data$concern))

# Add color groups for each plot style
concerns_data <- concerns_data %>%
  mutate(
    # Top-right plot: Top 7 vs Others
    group_top = ifelse(value >= 10.0, "Top 7", "Others"),
    
    # Bottom-right plot: Directly mapping specific items based on Figure 4.9 example
    group_bottom = case_when(
      concern %in% c(
        "Tires make excessive noise while driving",
        "Engine makes abnormal/excessive noise",
        "Excessive wind noise"
      ) ~ "Key Noise Items", # Dark red for key noise concerns
      value >= 10.0 ~ "Other Top Items", # Light pink for other top items
      TRUE ~ "Others" # Gray for bottom items (< 10.0)
    )
  )

# Common theme with y-axis labels included for all plots
base_theme <- theme_minimal(base_family = "sans") +
  theme(
    plot.title = element_text(face = "bold", size = 13),
    panel.grid.major.y = element_blank(),
    panel.grid.major.x = element_blank(),
    panel.grid.minor.x = element_blank(),
    axis.text.x = element_blank(),
    axis.ticks.x = element_blank(),
    axis.title.x = element_blank(),
    axis.title.y = element_blank(),
    axis.text.y = element_text(size = 12) 
  )

# 2. Left Plot: Explore (Neutral gray bar chart)
p_left <- ggplot(concerns_data, aes(x = value, y = concern)) +
  geom_col(fill = "gray50", width = 0.7) +
  geom_text(aes(label = sprintf("%.1f", value)), hjust = 1.2, color = "white", size = 3.5, fontface = "bold") +
  annotate("text", x = 13.5, y = 10.6, label = "concerns per 1,000", hjust = 1, size = 3, color = "gray50") +
  labs(
    title = "Top 10 design concerns"
  ) +
  base_theme +
  coord_cartesian(xlim = c(0, 13.8), clip = "off")

# 3. Right-Top Plot: Explain Part 1 (Highlighting top 7 concerns with red)
p_right_top <- ggplot(concerns_data, aes(x = value, y = concern, fill = group_top)) +
  geom_col(width = 0.7) +
  scale_fill_manual(values = c("Top 7" = "#C0392B", "Others" = "gray60")) +
  geom_text(aes(label = sprintf("%.1f", value)), hjust = 1.2, color = "white", size = 3.5, fontface = "bold") +
  annotate("text", x = 13.5, y = 10.8, label = "concerns per 1,000", hjust = 1, size = 3, color = "gray50") +
  labs(
    title = "Top 10 design concerns"
  ) +
  base_theme +
  theme(legend.position = "none") +
  coord_cartesian(xlim = c(0, 13.8), clip = "off")

# 4. Right-Bottom Plot: Explain Part 2 (Directly specified groups: Key noise items in dark red, others in faded pink)
p_right_bottom <- ggplot(concerns_data, aes(x = value, y = concern, fill = group_bottom)) +
  geom_col(width = 0.7) +
  scale_fill_manual(values = c(
    "Key Noise Items"   = "#C0392B", # Dark red for the 3 noise-related concerns
    "Other Top Items"   = "#F5B7B1", # Faded pink for the remaining top concerns
    "Others"            = "gray60"   # Gray for bottom concerns (< 10.0)
  )) +
  geom_text(aes(label = sprintf("%.1f", value)), hjust = 1.2, color = "white", size = 3.5, fontface = "bold") +
  annotate("text", x = 13.5, y = 10.8, label = "concerns per 1,000", hjust = 1, size = 3, color = "gray50") +
  labs(
    title = "Top 10 design concerns"
  ) +
  base_theme +
  theme(legend.position = "none") +
  coord_cartesian(xlim = c(0, 13.8), clip = "off")

# 5. Combine using patchwork: Left column vs Right column (stacked top and bottom)
combined_plots <- p_left | (p_right_top / p_right_bottom)

# 6. Apply cowplot ggdraw to add global dividing line and Explore/Explain headers
final_canvas <- ggdraw(combined_plots) +
  geom_segment(aes(x = 0.5, y = 0.05, xend = 0.5, yend = 0.92), color = "#D0D5DD", linewidth = 1.2) +
  draw_label("Explore", x = 0.1, y = 0.98, fontface = "bold", color = "#1F4E79", size = 14, hjust = 0.5) +
  draw_label("Explain", x = 0.53, y = 0.98, fontface = "bold", color = "#1F4E79", size = 14, hjust = 0.5)

# Display final canvas
print(final_canvas)



