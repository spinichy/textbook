  Price = c(395, 360, 100, 160, 100)
)

p_right <- ggplot(price_long %>% filter(!is.na(Price)), 
                  aes(x = Year, y = Price, group = Product)) +
  # Add recommended price range shade ($150 - $200)
  annotate("rect", xmin = 2007.5, xmax = 2014.2, ymin = 150, ymax = 200, fill = "#1F4E79", alpha = 0.12) +
  annotate("text", x = 2007.6, y = 175, label = "Recommended range", color = "#1F4E79", fontface = "bold", size = 6, hjust = 0) +
  # Lines and points
  geom_line(color = "#999999", linewidth = 1.1) +
  # Direct product labels (A, B, C, D, E)
  geom_text(data = product_labels, aes(x = Year, y = Price, label = Product), 
            color = "#888888", fontface = "bold", size = 3.5, inherit.aes = FALSE) +
  # Highlight Average Point at 2014 ($223)
  annotate("point", x = 2014, y = 223, color = "#1F4E79", size = 3) +
  annotate("text", x = 2013.8, y = 223, label = "AVG", color = "#1F4E79", fontface = "bold", size = 2.8, hjust = 1) +
  scale_y_continuous(limits = c(0, 500), labels = scales::dollar_format(), breaks = seq(0, 500, 100)) +
  scale_x_continuous(breaks = 2008:2014) +
  labs(
    title = "To be competitive, we recommend introducing our product below\nthe $223 average price point in the $150-$200 range",
    subtitle = "Retail price over time by product",
    x = "Year",
    y = "Average price"
  ) +
  theme_minimal(base_family = "sans") +
  theme(
    panel.grid.minor = element_blank(),
    panel.grid.major.x = element_blank(),
    plot.title = element_text(face = "bold", size = 14, color = "black", lineheight = 1.1),
    plot.subtitle = element_text(size = 9, color = "#555555", margin = margin(b = 10)),
    axis.title.x = element_text(size = 9, color = "#555555"),
    axis.title.y = element_text(size = 9, color = "#555555"),
    axis.text = element_text(size = 8, color = "#555555")
  )

# 4. Combine plots side by side (Left: Bar chart | Right: Line chart)
combined_plots <- p_left | p_right
combined_plots <- combined_plots + plot_layout(widths = c(0.95, 1.05))

# 5. Overlay 'Bad' and 'Good' labels at the title baseline using ggdraw
final_plot <- ggdraw(combined_plots) +
  draw_label("Bad", x = 0.45, y = 0.95, fontface = "bold", color = "#D9534F", size = 13, hjust = 1) +
  draw_label("Good", x = 0.965, y = 0.95, fontface = "bold", color = "#1F4E79", size = 13, hjust = 1)

# Print the final combined plot
print(final_plot)
