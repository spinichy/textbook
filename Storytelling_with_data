# ==========================================
create_story_plot <- function(highlight_cat, highlight_color, highlight_text) {
  
  # Assign color: highlighted category gets its designated color, others turn gray
  plot_df <- df %>%
    mutate(
      LineColor = ifelse(Category == highlight_cat, highlight_cat, "Others")
    )
  
  color_map <- c("Others" = "#cccccc")
  color_map[highlight_cat] <- highlight_color
  
  p <- ggplot(plot_df, aes(x = Year, y = Percent, group = Category, color = LineColor)) +
    # Draw gray background lines first, then the highlighted line on top
    geom_line(data = subset(plot_df, LineColor == "Others"), linewidth = 1.0, alpha = 0.8) +
    geom_line(data = subset(plot_df, LineColor != "Others"), linewidth = 1.4) +
    
    # Add a data point and label at the final year (2015) for the highlighted category
    geom_point(data = subset(plot_df, Category == highlight_cat & Year == 2015), size = 3.5) +
    
    scale_y_continuous(
      limits = c(0, 100),
      breaks = seq(0, 100, by = 10),
      labels = paste0(seq(0, 100, by = 10), "%"),
      expand = c(0, 0)
    ) +
    scale_x_continuous(
      breaks = years,
      limits = c(2010, 2016.2), # Expand x-axis slightly to fit the end label comfortably
      expand = c(0.02, 0.02)
    ) +
    scale_color_manual(values = color_map) +
    theme_minimal(base_family = "sans") +
    theme(
      plot.title = element_blank(),
      plot.subtitle = element_blank(),
      legend.position = "none",
      axis.title.x = element_blank(),
      axis.title.y = element_blank(),
      axis.text = element_text(size = 11, color = "#555555"),
      axis.ticks.y = element_line(color = "#cccccc"),
      axis.line.x = element_line(color = "#cccccc"),
      axis.line.y = element_line(color = "#cccccc"),
      panel.grid.major = element_blank(),
      panel.grid.minor = element_blank(),
      plot.margin = margin(50, 20, 40, 20)
    )
  
  # Wrap with ggdraw for precise layout annotations
  ggdraw(p) +
    draw_label("Types of non-profits supported by area funders", 
               x = 0.05, y = 0.99, hjust = 0, vjust = 1, 
               fontface = "plain", size = 16, colour = "#333333") +
    
    draw_label("Percent of funders", 
               x = 0.01, y = 0.75, hjust = 0, vjust = 1, angle = 90, 
               size = 11, colour = "#555555") +
    
    draw_label(highlight_text, 
               x = 0.79, y = 0.76, hjust = 0, vjust = 0.5, 
               fontface = "bold", size = 12, colour = highlight_color) +
    
    draw_label("Data is self-reported by funders; percents sum to greater than 100 because respondents\ncan make multiple selections.", 
               x = 0.05, y = 0.03, hjust = 0, vjust = 0, 
               size = 8.5, colour = "#777777")
}

