# Common dataset definition (Sep 2013 - May 2015)
df_full <- data.frame(
  date = seq(as.Date("2013-09-01"), as.Date("2015-05-01"), by = "month"),
  active_users = c(
    5800, 7200, 9100, 11000,                                     # Sep - Dec 2013 (4)
    20500, 26000, 28800, 29800, 32500, 30900, 30500, 32800, 
    34200, 36200, 37800, 39000,                                   # Jan - Dec 2014 (12)
    39500, 50200, 61500, 82000, 94500                             # Jan - May 2015 (5)
  )
)

# Function to generate ggplot for each of the 5 steps provided by the user
create_step_plot <- function(step_num) {
  
  if (step_num == 1) {
    # Step 1: White line (blending into background) and single filled blue point at start
    df_plot <- df_full
    df_plot$active_users <- NA 
    line_color <- "white"
    point_data <- df_full[1, ]
    point_aes <- geom_point(data = point_data, shape = 21, size = 3.5, fill = "#2b7bb9", color = "#2b7bb9", stroke = 1.5)
    
  } else if (step_num == 2) {
    # Step 2: Line up to Dec 2013, points at Sep 2013 and Dec 2013
    df_plot <- df_full
    df_plot$active_users[5:21] <- NA
    line_color <- "#2b7bb9"
    point_data <- subset(df_full, date == as.Date("2013-09-01") | date == as.Date("2013-12-01"))
    point_aes <- geom_point(data = point_data, shape = 21, size = 3.5, fill = "white", color = "#2b7bb9", stroke = 1.5)
    
  } else if (step_num == 3) {
    # Step 3: Line up to Apr 2014, points at Sep 2013, Dec 2013, and Apr 2014
    df_plot <- df_full
    df_plot$active_users[9:21] <- NA
    line_color <- "#2b7bb9"
    point_data <- subset(df_full, date == as.Date("2013-09-01") | date == as.Date("2013-12-01") | date == as.Date("2014-04-01"))
