# Load required libraries
library(ggplot2)
library(dplyr)
library(tidyr)
library(patchwork)
library(cowplot) # Required for precise title-level annotation

# Create the ticket volume dataset
ticket_data <- data.frame(
  Month = factor(
    c("Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"),
    levels = c("Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec")
  ),
  Received = c(160, 184, 241, 149, 180, 161, 132, 202, 160, 139, 149, 177),
  Processed = c(160, 184, 237, 148, 181, 150, 123, 156, 126, 104, 124, 140)
)

# Reshape data from wide to long format
ticket_long <- ticket_data %>%
  pivot_longer(
    cols = c(Received, Processed),
    names_to = "Metric",
    values_to = "Volume"
  )

# Add conditional flags for labels (Show numbers only from August onward)
ticket_long <- ticket_long %>%
  mutate(
    show_num = ifelse(Month %in% c("Aug", "Sep", "Oct", "Nov", "Dec"), as.character(Volume), NA_character_)
  )

# Separate end-point data for 'Received' and 'Processed' text annotations
end_labels <- ticket_long %>%
  filter(Month == "Dec")

# 1. Left Plot: Ticket Trend (Bar Chart - Bad)
p_left <- ggplot(ticket_long, aes(x = Month, y = Volume, fill = Metric)) +
  geom_col(position = "dodge", width = 0.7) +
  geom_text(aes(label = Volume), position = position_dodge(0.7), vjust = -0.5, size = 2.8) +
  scale_fill_manual(values = c("Received" = "#2F75B5", "Processed" = "#D9534F")) +
  scale_y_continuous(limits = c(0, 320), breaks = seq(0, 300, 50)) +
  labs(
    title = "Ticket Trend",
    subtitle = "Example 1 (before): showing data",
    x = NULL,
    y = NULL,
    fill = NULL
  ) +
  theme_minimal(base_family = "sans") +
  theme(
    panel.grid.minor = element_blank(),
    panel.grid.major.x = element_blank(),
    plot.title = element_text(face = "bold", size = 13, color = "#333333"),
    plot.subtitle = element_text(size = 9, color = "#555555"),
    legend.position = "bottom",
    axis.text.x = element_text(angle = 30, hjust = 1)
  )

# 2. Right Plot: Storytelling with Data (Line Chart - Good)
p_right <- ggplot(ticket_long, aes(x = Month, y = Volume, group = Metric, color = Metric)) +
  geom_line(linewidth = 1.1) +
  geom_point(size = 2.5) +
  geom_text(aes(label = show_num), vjust = -0.8, size = 2.8, show.legend = FALSE) +
  geom_text(
    data = end_labels,
    aes(x = Month, y = Volume, label = Metric, color = Metric),
    hjust = -0.2, fontface = "bold", size = 3.5, show.legend = FALSE
  ) +
  geom_vline(xintercept = "May", linetype = "solid", color = "grey60", linewidth = 0.7) +
  scale_color_manual(values = c("Received" = "#888888", "Processed" = "#1F4E79")) +
  scale_y_continuous(limits = c(0, 320), breaks = seq(0, 300, 50)) +
  scale_x_discrete(expand = expansion(mult = c(0.05, 0.25))) +
  coord_cartesian(clip = "off") +
  labs(
    title = "Ticket volume over time",
    subtitle = "2 employees quit in May. We nearly kept up with incoming volume\nin the following two months, but fell behind with the increase in Aug\nand haven't been able to catch up since.",
    x = "2014",
    y = NULL,
    color = NULL
  ) +
  theme_minimal(base_family = "sans") +
  theme(
    panel.grid.minor = element_blank(),
    panel.grid.major.x = element_blank(),
    plot.title = element_text(face = "bold", size = 13, color = "#333333"),
    plot.subtitle = element_text(size = 8.5, color = "#555555", lineheight = 1.1),
    axis.title.x = element_text(hjust = 0, color = "#555555", size = 9),
    legend.position = "none",
    axis.text.x = element_text(angle = 30, hjust = 1)
  )

# Combine plots side by side using patchwork
combined_plots <- p_left | p_right

# Overlay 'Bad' and 'Good' precisely on the title baseline level using cowplot
final_plot <- ggdraw(combined_plots) +
  draw_label("Bad", x = 0.47, y = 0.945, fontface = "bold", color = "#D9534F", size = 13, hjust = 1) +
  draw_label("Good", x = 0.965, y = 0.945, fontface = "bold", color = "#1F4E79", size = 13, hjust = 1)

# Display the final plot
print(final_plot)



