## Pie Chart
#-------------------------------------------------------------------------------



# Load required libraries
library(ggplot2)
library(dplyr)

# Prepare dataset with 5 categories using the built-in diamonds dataset
data("diamonds")
survey_data <- diamonds %>%
  count(cut) %>%
  mutate(percentage = round(n / sum(n) * 100, 1))

# Open a new graphics window for Windows OS
windows(width = 8, height = 6)

# Create the pie chart using ggplot2
ggplot(survey_data, aes(x = "", y = n, fill = cut)) +
  geom_bar(stat = "identity", width = 1, color = "white") +
  coord_polar("y", start = 0) +
  geom_text(aes(label = paste0(cut, "\n(", percentage, "%)")), 
            position = position_stack(vjust = 0.5), 
            color = "black", fontface = "bold", size = 3.5) +
  scale_fill_brewer(palette = "Set2") +
  theme_void() +
  # Add title and source caption using labs()
  labs(
    title = "Diamond Cut Distribution (5 Categories)", 
    fill = "Cut Quality",
    caption = "Source: ggplot2 diamonds dataset"
  ) +
  theme(
    # Move the title down and adjust margin
    plot.title = element_text(hjust = 0.5, face = "bold", size = 14, 
                              margin = margin(t = 30, b = 15)),
    # Align caption to the right (hjust = 1) and pull it closer to the chart using top margin (t)
    plot.caption = element_text(hjust = 1, size = 9, color = "gray40", face = "italic",
                                margin = margin(t = -10, r = 10)),
    # Add overall plot margin
    plot.margin = unit(c(1, 1, 1, 1), "cm"),
    legend.position = "right"
  )



