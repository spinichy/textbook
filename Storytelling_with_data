  mutate(Supplier = factor(Supplier, levels = c("Supplier C", "Supplier D", "Supplier B", "Supplier A")))

slice_colors <- c("#0B3C5D", "#328CC1", "#B3CDE0", "#6497B1")

# 2. Function to render 3D pie charts safely to temporary PNG and record as grob
get_3d_pie_grob <- function(show_labels = FALSE) {
  tf <- tempfile(fileext = ".png")
  png(tf, width = 500, height = 500, res = 120)
  
  par(mar = c(1, 1, 3, 1), xpd = TRUE)
  labels_vec <- if(show_labels) paste0(df_supplier$Share, "%") else NULL
  
  pie3D(
    df_supplier$Share,
    labels = labels_vec,
    labelcex = 1.0,
    explode = 0.08,
    col = slice_colors,
    theta = 1.15,
    height = 0.12,
    border = "white",
    radius = 0.95
  )
  title(main = "Supplier Market Share", cex.main = 1.1, col.main = "#555555", adj = 0)
  dev.off()
  
  img_raster <- png::readPNG(tf)
  unlink(tf)
  
  return(grid::rasterGrob(img_raster, interpolate = TRUE))
}

# Generate Grobs for 3D Pies
grob_evil <- get_3d_pie_grob(show_labels = FALSE)
grob_bad  <- get_3d_pie_grob(show_labels = TRUE)

