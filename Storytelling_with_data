# Load required libraries
library(ggplot2)
library(cowplot)
library(dplyr)

# 1. Create data frame where Our Business values strictly align with the reference ranks
set.seed(2026)
categories <- c("Price", "Convenience", "Relationship", "Service", "Selection")
competitors <- c("Our Business", "Competitor A", "Competitor B", "Competitor C", "Competitor D", "Competitor E")

df <- expand.grid(Category = categories, Business = competitors)

# Define values explicitly to match the exact visual lengths in the reference image
df <- df %>% mutate(
  Value = case_when(
    # Our Business: Price is longest (1 of 6), Service/Selection are shortest (6 of 6)
    Business == "Our Business" & Category == "Price" ~ 1.45,       # Rank 1
    Business == "Our Business" & Category == "Convenience" ~ 1.15, # Rank 2
    Business == "Our Business" & Category == "Relationship" ~ 0.7, # Rank 4
    Business == "Our Business" & Category == "Service" ~ 0.25,     # Rank 6 (Very short)
    Business == "Our Business" & Category == "Selection" ~ 0.2,    # Rank 6 (Very short)
    
    # Competitor values (randomized gray bars)
    TRUE ~ runif(n(), 0.1, 1.4)
  )
)

# Dynamically calculate the rank based on the assigned values within each category
df <- df %>%
  group_by(Category) %>%
  mutate(
    Rank = rank(-Value, ties.method = "min"),
    RankText = ifelse(Business == "Our Business", paste0(Rank, " of 6"), "")
  ) %>%
  ungroup()

# Ensure correct factor ordering (Price at top, Selection at bottom)
df$Business <- factor(df$Business, levels = rev(competitors))
df$Category <- factor(df$Category, levels = categories)

# 2. Create the "Bad" plot (Scatter plot with a single-row horizontal legend)
p_bad <- ggplot(df, aes(x = Category, y = Value, color = Business)) +
  geom_point(size = 3) +
  geom_hline(yintercept = 0, color = "darkgray", linetype = "solid") +
  labs(title = "Weighted Performance Index", x = NULL, y = NULL) +
  theme_minimal() +
  theme(
    plot.title = element_text(face = "bold", size = 12, hjust = 0.5),
    legend.position = "bottom",
    legend.direction = "horizontal",
    legend.title = element_blank(),
    legend.text = element_text(size = 7)
  ) +
  guides(color = guide_legend(nrow = 1))

# 3. Create the "Good" plot matching the exact reference layout
p_good <- ggplot(df, aes(x = Business, y = Value, fill = Business)) +
  geom_col(width = 0.7) +
  coord_flip() +
  facet_grid(Category ~ ., switch = "y") + # Price on top, Selection at bottom
  scale_fill_manual(values = c(
    "Our Business" = "#1F4E79", 
    "Competitor A" = "gray75", 
    "Competitor B" = "gray75", 
    "Competitor C" = "gray75", 
    "Competitor D" = "gray75", 
    "Competitor E" = "gray75"
  )) +
  # Display dynamic rank text matching the exact bar length
  geom_text(
    aes(label = RankText),
