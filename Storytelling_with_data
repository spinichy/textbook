## 100% Stacked Vertical Bar Chart
#-------------------------------------------------------------------------------



# Load required libraries
library(ggplot2)
library(dplyr)
library(tidyr)

# Use the built-in HairEyeColor dataset to get actual real-world multi-group data
data("HairEyeColor")
hair_df <- as.data.frame(HairEyeColor)

# Aggregate actual data by Sex (Group) and Hair/Eye segments
# Here, 'Sex' acts as the 2 groups (Male vs Female) and 'Hair' acts as the segments
segment_real_data <- hair_df %>%
  group_by(Sex, Hair) %>%
  summarise(Count = sum(Freq), .groups = "drop") %>%
  group_by(Sex) %>%
  mutate(
    Proportion = Count / sum(Count),
    Percent_Label = paste0(round(Proportion * 100, 0), "%")
  ) %>%
  ungroup()

# Rename columns for clarity
colnames(segment_real_data)[1:2] <- c("Group", "Segment")

# Create the 100% stacked vertical bar chart with actual data using ggplot2
ggplot(segment_real_data, aes(x = Group, y = Proportion, fill = Segment)) +
  # Use position = "fill" to scale bars to 100%
  geom_bar(stat = "identity", position = "fill", width = 0.5) +
  # Add percentage text labels inside the segments
  geom_text(aes(label = Percent_Label), 
            position = position_fill(vjust = 0.5), 
            color = "white", fontface = "bold", size = 5) +
  # Format y-axis as percentage
  scale_y_continuous(labels = scales::percent_format()) +
