  geom_line(color = "#888888", linewidth = 1) +
  scale_y_continuous(limits = c(0, 300), breaks = seq(0, 300, 50)) +
  scale_x_discrete(expand = expansion(mult = c(0.05, 0.22))) + # 오른쪽 여백 확장
  theme_swd() +
  annotate("text", x = 12.1, y = 185, label = "Received", color = "#888888", fontface = "bold", hjust = 0, size = 3.2) +
