## Dot Plot / Scatter Plot
#-------------------------------------------------------------------------------



# Load required libraries
library(ggplot2)
library(dplyr)
library(tidyr)

# Use the built-in 'mtcars' dataset to create a realistic multi-entity comparison
# We compare different car models (Entities) across performance metrics (Variables)
mtcars_subset <- mtcars[1:6, c("mpg", "disp", "hp", "wt")]
mtcars_subset$Entity <- rownames(mtcars_subset)

# Normalize/scale the metrics so they fit on a comparable index scale around zero
performance_data <- mtcars_subset %>%
  mutate(
    MPG_Index = scale(mpg)[, 1],
    Disp_Index = scale(disp)[, 1],
    HP_Index = scale(hp)[, 1],
    WT_Index = scale(wt)[, 1]
  ) %>%
  select(Entity, MPG_Index, Disp_Index, HP_Index, WT_Index) %>%
  pivot_longer(cols = -Entity, names_to = "Metric", values_to = "Index_Value")

# Create the weighted index dot plot using ggplot2
ggplot(performance_data, aes(x = Metric, y = Index_Value, color = Entity, shape = Entity)) +
  # Add a horizontal reference line at y = 0
  geom_hline(yintercept = 0, color = "gray60", linewidth = 0.8) +
  # Draw points with customized size
  geom_point(size = 3.5, stroke = 1) +
  # Apply a clean minimal theme
  theme_minimal() +
  # Add title, axis labels, legend, and source caption
  labs(
    title = "Weighted Performance Index",
    x = NULL,
    y = "Index Value",
    color = "Entity",
    shape = "Entity",
    caption = "Source: R built-in mtcars dataset"
  ) +
  # Customize theme elements
  theme(
    plot.title = element_text(hjust = 0.5, face = "bold", size = 16, 
                              margin = margin(t = 20, b = 15)),
    plot.caption = element_text(hjust = 1, size = 9, color = "gray40", face = "italic",
                                margin = margin(t = -5, r = 5)),
    plot.margin = unit(c(1, 1, 1, 1), "cm"),
    legend.position = "bottom",
    legend.box = "horizontal",
    panel.grid.minor = element_blank()
  )



