# Calculate proportion of trace
eigenvalues <- pmax(eig$values, 0)
prop_trace <- eigenvalues / sum(eigenvalues)

# Print results
print("Linear Discriminant Coefficients (w):")
print(scaling[, 1:(K - 1)])

print("Proportion of trace:")
print(prop_trace[1:(K - 1)])



##LDA - Manual (2)


# Load the iris dataset
data(iris)

K <- length(unique(iris$Species))
p <- ncol(iris) - 1
N <- nrow(iris)
class_names <- levels(iris$Species)

# 1. Priors (pi_k): 가정치로 예: 1/3씩 동일하게 설정
prior <- rep(1 / K, K)

# 2. Group means (mu_k) and Pooled Covariance Matrix (Sigma)
mu_k <- matrix(0, nrow = K, ncol = p)
rownames(mu_k) <- class_names
colnames(mu_k) <- colnames(iris)[1:p]

# Within-class scatter matrix to compute pooled covariance (Sigma)
S_W <- matrix(0, nrow = p, ncol = p)

for (i in 1:K) {
  X_k <- as.matrix(iris[iris$Species == class_names[i], 1:p])
  mu_k[i, ] <- colMeans(X_k)
  diff_k <- sweep(X_k, 2, mu_k[i, ], "-")
  S_W <- S_W + t(diff_k) %*% diff_k
}

# Pooled covariance matrix (Sigma)
# MASS::lda uses divisor N - K
Sigma <- S_W / (N - K)
inv_Sigma <- solve(Sigma)

# 3. Calculate Linear Discriminant Function coefficients based on the image derivation:
# delta_k(x) = x^T * inv_Sigma * mu_k - 0.5 * mu_k^T * inv_Sigma * mu_k + log(pi_k)
# This can be written as: delta_k(x) = w_k^T * x + w_0k
# where w_k = inv_Sigma * mu_k  (Linear coefficients)
# and w_0k = -0.5 * mu_k^T * inv_Sigma * mu_k + log(pi_k) (Constant)

linear_coeffs <- matrix(0, nrow = p, ncol = K)
colnames(linear_coeffs) <- class_names
rownames(linear_coeffs) <- colnames(iris)[1:p]

constants <- numeric(K)
names(constants) <- class_names

for (i in 1:K) {
  mu_i <- matrix(mu_k[i, ], ncol = 1)
  
  # Linear coefficients for class i (w_k)
  linear_coeffs[, i] <- inv_Sigma %*% mu_i
  
  # Constant (intercept) for class i (w_0k)
  constants[i] <- -0.5 * t(mu_i) %*% inv_Sigma %*% mu_i + log(prior[i])
}

# Print results derived from Bayesian/Generative LDA formulation
print("Linear Discriminant Coefficients (w_k = Sigma^(-1) * mu_k):")
print(linear_coeffs)

print("Constants (w_0k):")
print(constants)




