data(iris)

K <- length(unique(iris$Species))
p <- ncol(iris) - 1
N <- nrow(iris)

prior <- rep(1 / K, K)
class_names <- levels(iris$Species)

# Overall mean vector (mu)
mu_overall <- colMeans(iris[, 1:p])

# Group means (mu_k) and Within-class scatter matrix (S_W)
mu_k <- matrix(0, nrow = K, ncol = p)
rownames(mu_k) <- class_names
colnames(mu_k) <- colnames(iris)[1:p]

S_W <- matrix(0, nrow = p, ncol = p)

for (i in 1:K) {
  X_k <- as.matrix(iris[iris$Species == class_names[i], 1:p])
  mu_k[i, ] <- colMeans(X_k)
  diff_k <- sweep(x = X_k, MARGIN = 2, STATS = mu_k[i, ],FUN =  "-")
  S_W <- S_W + t(diff_k) %*% diff_k
}
S_W <- S_W / (N - K)

# Between-class scatter matrix (S_B)
S_B <- matrix(0, nrow = p, ncol = p)
for (i in 1:K) {
  n_k <- nrow(iris[iris$Species == class_names[i], ])
  mean_diff <- matrix(mu_k[i, ] - mu_overall, ncol = 1)
  S_B <- S_B + n_k * (mean_diff %*% t(mean_diff))
}
S_B <- S_B / (K - 1)

# Solve Generalized Eigenvalue Problem using Cholesky decomposition of S_W
L <- chol(S_W)
inv_L <- solve(t(L))
inv_L_S_B <- inv_L %*% S_B %*% solve(L)


# Transform eigenvectors back to original space
