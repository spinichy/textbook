#MDS - Manual(1)

# 0. Prepare data
data("voting", package = "HSAUR")
delta <- as.matrix(voting)
n <- nrow(delta)

# 1. Smart initial coordinate setup using Classical MDS (Torgerson scaling)
# (Mimics how isoMDS initializes coordinates internally)
B <- -0.5 * (delta^2 
             - rowMeans(delta^2) 
             - rep(colMeans(delta^2), each=n)
             + mean(delta^2))
eig <- eigen(B)

# Construct initial coordinates using the top 2 eigenvectors
coords <- eig$vectors[, 1:2] %*% diag(sqrt(pmax(eig$values[1:2], 0)))
rownames(coords) <- colnames(voting)

# 2. Set optimization parameters
max_iter <- 1500
learning_rate <- 0.0001
prev_stress <- Inf

# 3. Iterative optimization loop
for (iter in 1:max_iter) {
  
  # Calculate Euclidean distance matrix from current coordinates
  d <- as.matrix(dist(coords))
  
  # Perform Isotonic Regression (Monotone transformation)
  x_val <- delta[lower.tri(delta)]
  y_val <- d[lower.tri(d)]
  
  o <- order(x_val)
  iso <- isoreg(x_val[o], y_val[o])
  
  d_hat_vals <- numeric(length(x_val))
  d_hat_vals[o] <- iso$yf
  
  d_hat_matrix <- matrix(0, n, n)
  d_hat_matrix[lower.tri(d_hat_matrix)] <- d_hat_vals
  d_hat_matrix <- d_hat_matrix + t(d_hat_matrix)
  
  # Calculate Raw Stress
  stress <- sum((d - d_hat_matrix)^2)
  
  if (abs(prev_stress - stress) < 1e-7) {
    break
  }
  prev_stress <- stress
  
  # Steepest Descent Gradient update
  grad <- matrix(0, n, 2)
  for (i in 1:n) {
    for (j in 1:n) {
      if (i != j && d[i, j] > 0) {
        diff_factor <- (d[i, j] - d_hat_matrix[i, j]) / d[i, j]
        grad[i, ] <- grad[i, ] + diff_factor * (coords[i, ] - coords[j, ])
      }
    }
  }
  
  # Update coordinates
  coords <- coords - learning_rate * grad
}

# 4. Plot final results
windows()
plot(coords[, 1], coords[, 2],
     type = "n", xlab = "Coordinate 1", ylab = "Coordinate 2",
     xlim = range(coords[, 1]) * 1.3,
     ylim = range(coords[, 2]) * 1.3,
     main = "Kruskal's Non-metric MDS (With Classical MDS Initialization)")

abline(v = 0, h = 0, col = "gray", lty = 2)
text(coords[, 1], coords[, 2], labels = rownames(coords))


