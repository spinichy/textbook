### hierarchical clustering - Manual



data("USArrests")
n <- nrow(USArrests)
X <- as.matrix(USArrests)

# 1. Manually calculate squared Euclidean distance matrix
sq_dist_matrix <- matrix(0, nrow = n, ncol = n)
rownames(sq_dist_matrix) <- rownames(USArrests)
colnames(sq_dist_matrix) <- rownames(USArrests)

for (i in 1:n) {
  for (j in 1:n) {
    sq_dist_matrix[i, j] <- sum((X[i, ] - X[j, ])^2)
  }
}

# 2. Ward's Minimum Variance Method from scratch using Lance-Williams formula
max_nodes <- 2 * n - 1
D <- matrix(0, nrow = max_nodes, ncol = max_nodes)
D[1:n, 1:n] <- sq_dist_matrix

cluster_sizes <- rep(1, max_nodes)
active <- rep(FALSE, max_nodes)
active[1:n] <- TRUE

merges <- matrix(0, nrow = n - 1, ncol = 2)
heights <- numeric(n - 1)

node_names <- -(1:n)
next_node_id <- 1

for (step in 1:(n - 1)) {
  min_val <- Inf
  u_idx <- 0
  v_idx <- 0
  
  active_indices <- which(active)
  k <- length(active_indices)
  
  for (i in 1:(k - 1)) {
    for (j in (i + 1):k) {
      r <- active_indices[i]
      c <- active_indices[j]
      if (D[r, c] < min_val) {
        min_val <- D[r, c]
        u_idx <- r
        v_idx <- c
      }
    }
  }
  node_names[u_idx]
  merges[step, 1] <- node_names[u_idx]
  merges[step, 2] <- node_names[v_idx]
  heights[step] <- sqrt(min_val)
  
  new_cluster <- n + step
  node_names[new_cluster] <- next_node_id
  next_node_id <- next_node_id + 1
  
  n_u <- cluster_sizes[u_idx]
  n_v <- cluster_sizes[v_idx]
  
  new_row <- numeric(max_nodes)
  for (k_idx in active_indices) {
    if (k_idx != u_idx && k_idx != v_idx) {
      n_k <- cluster_sizes[k_idx]
      d_ku <- D[k_idx, u_idx]
      d_kv <- D[k_idx, v_idx]
      d_uv <- D[u_idx, v_idx]
      
      val <- ((n_k + n_u) * d_ku + (n_k + n_v) * d_kv - n_k * d_uv) / (n_k + n_u + n_v)
      new_row[k_idx] <- val
    }
  }
  
  D[new_cluster, ] <- new_row
  D[, new_cluster] <- new_row
  
  cluster_sizes[new_cluster] <- n_u + n_v
  
  active[u_idx] <- FALSE
  active[v_idx] <- FALSE
  active[new_cluster] <- TRUE
}

# 3. Purely manual tree traversal function to compute the leaf order (no hclust order used)
get_order <- function(merge_matrix) {
  # Recursive function to get left-to-right leaf sequence from the merge matrix
  node_cache <- list()
  
  build_seq <- function(node_idx) {
    if (node_idx < 0) {
      return(abs(node_idx))
    }
    if (!is.null(node_cache[[as.character(node_idx)]])) {
      return(node_cache[[as.character(node_idx)]])
    }
    left_child <- merge_matrix[node_idx, 1]
    right_child <- merge_matrix[node_idx, 2]
    
    res <- c(build_seq(left_child), build_seq(right_child))
    node_cache[[as.character(node_idx)]] <- res
    return(res)
  }
  
  root_node <- nrow(merge_matrix)
  build_seq(root_node)
}

manual_order <- get_order(merges)

# Construct hclust object entirely from scratch without calling hclust()
manual_hclust <- list(
  merge = merges,
  height = heights,
  order = manual_order,
  labels = rownames(USArrests),
  method = "ward.D2",
  dist.method = "euclidean"
)
