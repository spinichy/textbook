for (j in 0:N) {
  st <- stock_tree[j + 1, N + 1]
  conversion_value <- total_conversion_shares * st
  
  if (conversion_value > maturity_redemption) {
    # If stock conversion is worth more than cash redemption
    equity_part[j + 1, N + 1] <- conversion_value
    debt_part[j + 1, N + 1] <- 0
  } else {
    # If cash redemption is higher
    equity_part[j + 1, N + 1] <- 0
