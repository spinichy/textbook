# Black-Scholes Option Pricing Function
# Parameters:
# S: Current stock price
# K: Strike price
# T: Time to maturity (in years)
# r: Risk-free interest rate (annualized)
# sigma: Volatility of the underlying asset (annualized)

black_scholes <- function(S, K, T, r, sigma) {
  # Calculate d1 and d2 based on the derivation
  d1 <- (log(S / K) + (r + 0.5 * sigma^2) * T) / (sigma * sqrt(T))
  d2 <- d1 - sigma * sqrt(T)
  
  # Calculate call and put option prices
  call_price <- S * pnorm(d1) - K * exp(-r * T) * pnorm(d2)
  put_price  <- K * exp(-r * T) * pnorm(-d2) - S * pnorm(-d1)
  
  # Return results as a list
  return(list(
    Call = call_price,
    Put = put_price,
    Delta_Call = pnorm(d1),
    Delta_Put = pnorm(d1) - 1,
    Probability_ITM = pnorm(d2) # N(d2): Exercise probability
  ))
}

