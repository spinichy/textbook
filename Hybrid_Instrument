#Define function for condensed text-based tree output matching requested style
print_tree_condensed <- function(tree_matrix, title, max_steps = 4, N_total = N) {
  cat("\n=== ", title, " (Condensed Tree) ===\n", sep = "")
  
  early_steps <- 0:min(max_steps, N_total)
  
  # Print header
  cat(sprintf("%-7s", "Step:"))
  for (j in early_steps) {
    cat(sprintf("  t=%-3d", j))
  }
  cat("  ...   (Middle steps omitted) ...   Final (t=", N_total, ")\n", sep = "")
  
  # Print rows from 0 to max_steps
  max_i <- min(max_steps, nrow(tree_matrix) - 1)
  for (i in 0:max_i) {
    cat(sprintf("Up_%-4d:", i))
    for (j in early_steps) {
      val <- tree_matrix[i + 1, j + 1]
      if (!is.na(val)) {
        cat(sprintf(" %9.2f", val))
      } else {
        cat(sprintf(" %9s", ""))
      }
    }
    final_val <- tree_matrix[i + 1, N_total + 1]
    cat("    ...                              ", sprintf("%9.2f", final_val), "\n", sep = "")
  }
  cat("  ...\n")
  cat(sprintf("... (Total steps: %d, showing layout up to step %d and step %d)\n", N_total, max_steps, N_total))
}

