      best_equity <- conversion_value
      best_debt <- 0
    }
    
    # Step C: Check Put Option (Available after 2 years, i >= 2)
    if (i >= put_start_step && 
        put_value > (best_equity + best_debt) && 
        put_value > conversion_value) {
      best_equity <- 0
      best_debt <- put_value
    }
    
    # Store optimized values into matrices
