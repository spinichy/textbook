p <- (exp(rf * dt) - d) / (u - d)

# ==========================================
# 3. Create Stock Price Tree (Matrix of size 6 x 6)
# ==========================================
stock_tree <- matrix(0, nrow = N + 1, ncol = N + 1)

for (i in 0:N) {
  for (j in 0:i) {
    # j represents the number of upward movements
    stock_tree[j + 1, i + 1] <- S0 * (u^j) * (d^(i - j))
  }
}

# ==========================================
# 4. Initialize T-F Component Trees (Equity & Debt)
# ==========================================
equity_part <- matrix(0, nrow = N + 1, ncol = N + 1)
debt_part <- matrix(0, nrow = N + 1, ncol = N + 1)
cb_tree <- matrix(0, nrow = N + 1, ncol = N + 1)

