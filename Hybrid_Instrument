# Binomial Option Pricing Model (CRR Model) - 2-Year Maturity (N = 4 steps)
# Parameters setup
S0 <- 100     # Initial stock price
K <- 100      # Strike price
T <- 2.0      # Time to maturity in years (2 years)
N <- 4        # Number of steps (delta t = 0.5 years)
dt <- T / N   # Time step size (0.5 years)
sigma <- 0.20 # Volatility (20% per annum)

# Interest rate: 3% nominal annual rate compounded semi-annually
discount_factor_step <- 1.015 
r_dt <- log(discount_factor_step)

# Up and down factors
u <- exp(sigma * sqrt(dt))
d <- 1 / u

# Risk-neutral probability
p <- (discount_factor_step - d) / (u - d)

# 1. Generate Stock Price Tree (Matrix: rows = up states, cols = time steps)
stock_tree <- matrix(NA, nrow = N + 1, ncol = N + 1)
for (j in 0:N) {
  for (i in 0:j) {
    stock_tree[i + 1, j + 1] <- S0 * (u^i) * (d^(j - i))
  }
}
stock_tree

# 2. Generate Option Value Tree via Backward Induction
option_tree <- matrix(NA, nrow = N + 1, ncol = N + 1)

# Calculate option payoff at maturity (Step N)
for (i in 0:N) {
  option_tree[i + 1, N + 1] <- max(stock_tree[i + 1, N + 1] - K, 0)
}

# Backward induction through intermediate and initial steps
for (j in (N - 1):0) {
  for (i in 0:j) {
    option_tree[i + 1, j + 1] <- exp(-r_dt) * (p * option_tree[i + 2, j + 2] + 
                                                 (1 - p) * option_tree[i + 1, j + 2])
  }
}

# Print the current option price
print(paste("2-Year European Call Option Price:", round(option_tree[1, 1], 4)))

# 3. Plotting the Binomial Trees for N = 4
par(mfrow = c(1, 2), mar = c(2, 2, 4, 2))

# Function to draw the tree layout
draw_tree <- function(tree_matrix, main_title) {
  plot(NA, xlim = c(-0.5, N + 0.5), ylim = c(-N/2 - 0.5, N/2 + 0.5),
       xlab = "", ylab = "", axes = FALSE, main = main_title)
  for (j in 0:N) {
    for (i in 0:j) {
      val <- tree_matrix[i + 1, j + 1]
      if (!is.na(val)) {
        # Y-coordinate alignment for tree nodes
        y_pos <- i - j / 2
        text(j, y_pos, labels = round(val, 2), cex = 0.75, font = 2, col = "darkblue")
        
        # Connect nodes with branches
        if (j < N) {
          # Up branch target position
          y_up <- (i + 1) - (j + 1) / 2
          segments(j, y_pos, j + 1, y_up, col = "gray60", lwd = 1.2)
          
          # Down branch target position
          y_down <- i - (j + 1) / 2
          segments(j, y_pos, j + 1, y_down, col = "gray60", lwd = 1.2)
        }
      }
    }
  }
}

# Draw Stock Price Tree and Option Value Tree side-by-side
draw_tree(stock_tree, "Stock Price Tree (N=4)")
draw_tree(option_tree, "European Call Option Tree (N=4)")

