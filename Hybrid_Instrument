d <- 1 / u
p <- (exp(rf * dt) - d) / (u - d)

# 2. Binomial Tree Parameters (CRR Parameters)
u <- exp(sigma * sqrt(dt))
d <- 1 / u
p <- (exp(rf * dt) - d) / (u - d) # Risk-neutral probability

# 3. Initialize Stock Price Tree
stock_tree <- matrix(NA, nrow = N + 1, ncol = N + 1)
for (i in 0:N) {
  for (j in 0:i) {
    stock_tree[j + 1, i + 1] <- S0 * (u^j) * (d^(i - j))
  }
}

# 4. Initialize Convertible Bond Value Tree & Component Trees (T-F Framework)
# T-F model splits CB into Equity-like part (discounted at rf) and Debt-like part (discounted at rd)
cb_tree <- matrix(NA, nrow = N + 1, ncol = N + 1)
equity_part <- matrix(NA, nrow = N + 1, ncol = N + 1)
debt_part <- matrix(NA, nrow = N + 1, ncol = N + 1)

# 5. Boundary Conditions at Maturity (T = 60 months, 2027-12-31)
# At maturity, holder compares conversion value vs redemption value with 6% annual compound YTM
maturity_redemption <- face_value * (1 + 0.06)^T_years

for (j in 0:N) {
  st <- stock_tree[j + 1, N + 1]
  conversion_value <- (face_value / K) * st
  
  if (conversion_value > maturity_redemption) {
    # Optimal to convert into equity
    equity_part[j + 1, N + 1] <- conversion_value
    debt_part[j + 1, N + 1] <- 0
  } else {
    # Hold to maturity and collect cash redemption
    equity_part[j + 1, N + 1] <- 0
    debt_part[j + 1, N + 1] <- maturity_redemption
  }
  cb_tree[j + 1, N + 1] <- equity_part[j + 1, N + 1] + debt_part[j + 1, N + 1]
}

# 6. Backward Induction through the Tree
# Put option available from 2024-12-31 (2 years later, i = 24) to maturity
put_start_step <- 24 

for (i in (N - 1):0) {
  current_time_years <- i * dt
  
  # Calculate put redemption value if applicable (6% annual compound from inception)
  put_value <- face_value * ((1 + ytm_put)^current_time_years)
  
  for (j in 0:i) {
    st <- stock_tree[j + 1, i + 1]
    conversion_value <- (face_value / K) * st
    
    # Expected continuation values discounted at respective rates (T-F dual discounting)
    exp_equity <- exp(-rf * dt) * (p * equity_part[j + 2, i + 2] + (1 - p) * equity_part[j + 1, i + 2])
    exp_debt <- exp(-rd * dt) * (p * debt_part[j + 2, i + 2] + (1 - p) * debt_part[j + 1, i + 2])
    
    # Default continuation value in T-F framework
    cont_value <- exp_equity + exp_debt
    
    # Check early exercise conditions (Conversion vs Put vs Continuation)
    best_equity <- exp_equity
    best_debt <- exp_debt
    
    # 1. Conversion option check (available anytime after 1 year, i >= 12 based on image text)
    if (i >= 12 && conversion_value > cont_value) {
      best_equity <- conversion_value
      best_debt <- 0
    }
    
    # 2. Put option check (available after 2 years, i >= 24)
    if (i >= put_start_step && put_value > (best_equity + best_debt) && put_value > conversion_value) {
      # If put is exercised, investor receives cash (treated fully as debt recovery or put payout)
      best_equity <- 0
      best_debt <- put_value
    }
    
    equity_part[j + 1, i + 1] <- best_equity
    debt_part[j + 1, i + 1] <- best_debt
    cb_tree[j + 1, i + 1] <- best_equity + best_debt
  }
}

