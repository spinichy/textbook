# Complete and Corrected Black-Derman-Toy (BDT) Binomial Tree Model Implementation in R
# Note: All internal code comments are written in English.

# 1. Define model parameters and target market data
n_periods <- 3                      # Number of time steps (years)
dt <- 1.0                           # Time step size
sigma <- 0.15                       # Constant annual volatility parameter
target_prices <- c(0.95, 0.90, 0.84)# Target zero-coupon bond prices for t = 1, 2, 3
p <- 0.5                            # Risk-neutral probability
face_value <- 100                   # Bond face value

# Initialize the short-rate tree matrix and a_params vector
rate_tree <- matrix(NA, nrow = n_periods, ncol = n_periods)
a_params <- numeric(n_periods)

# 2. Calibrate a_1 for the first period (exact match to target_prices[1])
a_params[1] <- -log(target_prices[1]) / dt
rate_tree[1, 1] <- a_params[1]

# 3. Dynamic calibration and tree construction for subsequent periods
for (i in 2:n_periods) {
  
  # Objective function to find a_i such that the model bond price matches the target market price
  objective_func <- function(a_guess) {
    state_indices <- (1:i) - 1 - (i - 1) / 2
    temp_rates <- a_guess * exp(2 * state_indices * sigma * sqrt(dt))
    
    # Temporarily construct the full tree up to period i
    temp_tree <- rate_tree
    temp_tree[i, 1:i] <- temp_rates
    
    # Corrected backward induction for an i-period zero-coupon bond (from step i down to 1)
    bond_vals <- rep(face_value, i + 1) # Maturity payoff has i + 1 nodes
    for (step in i:1) {
      next_vals <- numeric(step)
      for (node in 1:step) {
        r_node <- temp_tree[step, node]
        next_vals[node] <- (p * bond_vals[node] + (1 - p) * bond_vals[node + 1]) / (1 + r_node * dt)
      }
      bond_vals <- next_vals
    }
    
    model_price <- bond_vals[1] / face_value
    return(model_price - target_prices[i])
  }

  # Use uniroot with a safe interval now that the objective function correctly depends on a_guess
  root_result <- uniroot(objective_func, interval = c(1e-5, 5.0))
  a_params[i] <- root_result$root
  
  # Populate the official short-rate tree for period i
  state_indices <- (1:i) - 1 - (i - 1) / 2
  rate_tree[i, 1:i] <- a_params[i] * exp(2 * state_indices * sigma * sqrt(dt))
}

# Print the fully calibrated BDT short-rate tree
print("Fully Calibrated BDT Short-Rate Tree:")
print(rate_tree)

# 4. Final backward induction pricing example for a 3-period bond on the tree
final_bond_values <- rep(face_value, n_periods + 1)
for (step in n_periods:1) {
  next_values <- numeric(step)
  for (node in 1:step) {
    r_current <- rate_tree[step, node]
    next_values[node] <- (p * final_bond_values[node] + (1 - p) * final_bond_values[node + 1]) / (1 + r_current * dt)
  }
  final_bond_values <- next_values
}

