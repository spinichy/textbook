           color = "black", fill = "white", fontface = "bold", size = 3.8) +
  # Expanded y-limits to start from 0 to prevent cutting off early values
  scale_y_continuous(limits = c(0, 0.5), breaks = seq(0, 0.5, by = 0.1)) +
  labs(
    title = "(B) Probability of Drawing a 10 or Jack",
    subtitle = "Empirical convergence vs. Theoretical exact value",
    x = "Number of Draws (N)",
