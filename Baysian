# Load required library
library(ggplot2)

# Set parameters for the normal distribution (e.g., standard normal: mu = 0, sd = 1)
mu <- 0
sigma <- 1

# Define the normal probability density function
p <- function(x) {
  return(dnorm(x, mean = mu, sd = sigma))
}

# Set the interval boundaries from mu - sigma to mu + sigma
xlow <- mu - sigma
xhigh <- mu + sigma

# Define a small step size for numerical approximation
dx <- 0.001

# Create a data frame for plotting over a wider range (mu - 3*sigma to mu + 3*sigma)
x_vals <- seq(mu - 3 * sigma, mu + 3 * sigma, by = dx)
df <- data.frame(x = x_vals, y = p(x_vals))

# Subset data for shading the area between mu - sigma and mu + sigma
df_shaded <- subset(df, x >= xlow & x <= xhigh)

# Calculate approximate integral (probability mass) using the rectangle rule
approx_integral <- sum(df_shaded$y * dx)
max_val <- max(df$y)

# Create text label to display inside the plot
label_text <- paste0(
  "Interval: [mu - sigma, mu + sigma]\n",
  "Approx. Probability = ", round(approx_integral, 4), "\n",
  "Max p(x) = ", round(max_val, 4)
)

# Plot using ggplot2 with text annotation and removed internal grid lines
ggplot(df, aes(x = x, y = y)) +
  geom_line(color = "forestgreen", linewidth = 1.2) +
  # Shade the target area between mu - sigma and mu + sigma
  geom_area(data = df_shaded, aes(x = x, y = y), fill = "forestgreen", alpha = 0.3) +
  # Add annotation box on the upper-right side to avoid overlapping the peak
  annotate(
    "label",
    x = mu + 1.2 * sigma, 
    y = max_val * 0.7,
    label = label_text,
    hjust = 0,
    vjust = 0.5,
    fill = "white",
    color = "black",
    size = 4,
    label.padding = unit(0.5, "lines")
  ) +
  labs(
    title = "Normal Probability Density Function: N(mu, sigma^2)",
    x = "x",
    y = "p(x)"
  ) +
  theme_minimal() +
  theme(
    panel.grid.major = element_blank(), # Remove major grid lines
    panel.grid.minor = element_blank()  # Remove minor grid lines
  )



