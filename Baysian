# Load necessary libraries
library(ggplot2)
library(gridExtra)

# ==========================================
# 1. Top Plot: Standard Normal Distribution (95% HDI)
# ==========================================

# Generate x values for standard normal distribution
x_norm <- seq(-3.2, 3.2, length.out = 1000)
y_norm <- dnorm(x_norm, mean = 0, sd = 1)
df_norm <- data.frame(x = x_norm, y = y_norm)

# Define HDI bounds for standard normal (approx -1.96 to 1.96)
hdi_lower_norm <- -1.96
hdi_upper_norm <- 1.96

# Filter data for shaded area under the curve
df_norm_shade <- subset(df_norm, x >= hdi_lower_norm & x <= hdi_upper_norm)

# Create top plot
p1 <- ggplot(df_norm, aes(x = x, y = y)) +
  # Shaded area for 95% HDI
  geom_area(data = df_norm_shade, fill = "gray80", alpha = 0.8) +
  # Density curve
  geom_line(color = "#5B92E5", linewidth = 1.2) +
  # Dashed vertical lines at HDI bounds using annotate
  annotate("segment", x = hdi_lower_norm, xend = hdi_lower_norm, y = 0, yend = dnorm(hdi_lower_norm), 
           linetype = "dashed", color = "black") +
  annotate("segment", x = hdi_upper_norm, xend = hdi_upper_norm, y = 0, yend = dnorm(hdi_upper_norm), 
           linetype = "dashed", color = "black") +
  # Double-headed arrow for 95% HDI span
  annotate("segment", x = hdi_lower_norm, xend = hdi_upper_norm, y = 0.06, yend = 0.06,
           arrow = arrow(ends = "both", length = unit(0.15, "cm")), color = "black", linewidth = 0.8) +
  # Text annotations for bounds and label
  annotate("text", x = hdi_lower_norm - 0.25, y = 0.06, label = "-1.96", size = 3.5) +
  annotate("text", x = hdi_upper_norm + 0.25, y = 0.06, label = "1.96", size = 3.5) +
  annotate("text", x = 0, y = 0.12, label = "95% HDI", size = 4.5, fontface = "bold") +
  # Scales and theme settings
  scale_x_continuous(limits = c(-3.2, 3.2), breaks = seq(-3, 3, by = 1)) +
  scale_y_continuous(limits = c(0, 0.44), breaks = seq(0, 0.4, by = 0.1)) +
  labs(x = "x", y = "p(x)") +
  theme_classic() +
  theme(
    axis.line = element_line(color = "black"),
    panel.grid.major = element_blank(),
    panel.grid.minor = element_blank()
  )


