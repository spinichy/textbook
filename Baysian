  scale_x_log10(
    breaks = c(1, 2, 5, 10, 20, 50, 100, 200, 500),
    labels = c("1", "2", "5", "10", "20", "50", "100", "200", "500"),
    limits = c(0.7, 500) # Slightly expanded lower limit to fit the '0.5' text nicely
  ) +
  scale_y_continuous(limits = c(0.0, 1.0), breaks = seq(0.0, 1.0, 0.2)) +
  labs(
    title = "Running Proportion of Heads",
    x = "Flip Number (Log Scale)",
    y = "Proportion Heads"
  ) +
  annotate("text", x = 15, y = 0.85, label = seq_text, hjust = 0, size = 3.5) +
  annotate("text", x = 15, y = 0.78, label = end_prop_text, hjust = 0, size = 3.5) +
