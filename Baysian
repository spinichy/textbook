# Load required libraries
library(dplyr)
library(gt)

# 1. Define Prior probabilities: p(Grade)
prior <- c(
  "1st"  = 0.20,
  "6th"  = 0.20,
  "11th" = 0.60
)

# 2. Define Likelihood matrix: p(Food | Grade)
likelihood_matrix <- matrix(
  c(0.3, 0.6, 0.1,  # 1st graders
    0.6, 0.3, 0.1,  # 6th graders
    0.3, 0.1, 0.6), # 11th graders
  nrow = 3,
  byrow = TRUE,
  dimnames = list(
    Grade = c("1st", "6th", "11th"),
    Food  = c("Ice_cream", "Fruit", "French_fries")
  )
)

# 3. Calculate Joint Probability table: p(Grade, Food) = p(Food | Grade) * p(Grade)
joint_matrix <- likelihood_matrix * prior

# 4. Add marginal probabilities (Row sums and Column sums)
joint_df <- as.data.frame(joint_matrix)
joint_df$p_grade <- rowSums(joint_matrix) # Marginal probability of Grade: p(Grade)

# Calculate column sums for food marginals: p(Food)
col_totals <- colSums(joint_matrix)
col_totals["p_grade"] <- sum(col_totals) # Total sum should be 1.0

# Combine row-wise and column-wise marginals into a single data frame
final_table_df <- rbind(joint_df, Total_food = col_totals)
final_table_df <- final_table_df %>% 
  tibble::rownames_to_column(var = "Grade / Food")

# 5. Create a professional table using the 'gt' package with larger fonts and bold subtitle
gt_table <- final_table_df %>%
  gt() %>%
  tab_header(
    title = md("<span style='font-size:22px;'>Joint Probability Table: p(Grade, Food)</span>"),
    subtitle = md("<span style='font-size:18px;'><b>Calculated by Likelihood * Prior (p(Food | Grade) * p(Grade))</b></span>")
  ) %>%
  tab_options(
    table.font.size = px(14) # Overall table font size increased
  ) %>%
  cols_label(
    `Grade / Food` = "Grade",
    p_grade = "p(Grade)"
  ) %>%
  fmt_number(
    columns = -`Grade / Food`,
    decimals = 2
  ) %>%
  # Highlight the bottom marginal row (Total_food)
  tab_style(
    style = cell_fill(color = "#e8f5e9"),
    locations = cells_body(rows = 4)
  ) %>%
  # Highlight the rightmost marginal column (p_grade)
  tab_style(
    style = cell_fill(color = "#e8f5e9"),
    locations = cells_body(columns = p_grade)
  ) %>%
  # Apply bold style to both marginal rows and columns
  tab_style(
    style = cell_text(weight = "bold"),
    locations = cells_body(rows = 4)
  ) %>%
  tab_style(
    style = cell_text(weight = "bold"),
    locations = cells_body(columns = p_grade)
  ) %>%
  tab_source_note(
    source_note = "Note: Marginal probabilities p(Grade) and p(Food) are highlighted."
  )

# Print the gt table
gt_table
