library(gt)
library(dplyr)

# Create dataset
x_vals <- 1:4

df <- data.frame(
  x = factor(x_vals, labels = c("x = 1", "x = 2", "x = 3", "x = 4")),
  Model_A = rep(1/4, 4),
  Model_B = x_vals / 10,
  Model_C = 12 / (25 * x_vals)
)

# Build a formatted table using gt
table_result <- df %>%
  gt() %>%
  tab_header(
    title = md("**Probability Distributions of Tetrahedral Die Models**"),
    subtitle = "Comparison of Fair (Model A) vs Biased Models (Model B & C)"
  ) %>%
  cols_label(1
    x = md("**Outcome ($x$)**"),
    Model_A = md("**Model A**<br>($p(x) = 1/4$)"),
    Model_B = md("**Model B**<br>($p(x) = x/10$)"),
    Model_C = md("**Model C**<br>($p(x) = 12/25x$)")
  ) %>%
  fmt_number(
    columns = c(Model_A, Model_B, Model_C),
    decimals = 2
  ) %>%
  data_color(
    columns = c(Model_A, Model_B, Model_C),
    palette = "Blues"
  ) %>%
  cols_align(
    align = "center",
    columns = everything()
  ) %>%
  tab_source_note(
    source_note = md("*Note: Model A is unbiased, Model B is biased toward higher values, and Model C is biased toward lower values.*")
  )

# Render table
table_result



