library(ggplot2)
library(dplyr)

# Set seed for reproducibility
set.seed(42)

# Total number of coin flips
n_flips <- 500

# Simulate coin flips (1 for Heads, 0 for Tails, assuming a fair coin p = 0.5)
flip_data <- data.frame(
  flip_num = 1:n_flips,
  outcome = sample(c(0, 1), size = n_flips, replace = TRUE, prob = c(0.5, 0.5))
)

# Calculate running proportion of heads
flip_data <- flip_data %>%
  mutate(
    cum_heads = cumsum(outcome),
    running_prop = cum_heads / flip_num,
    flip_char = ifelse(outcome == 1, "H", "T")
  )

# Create a sample flip sequence text for annotation (first 10 flips)
seq_preview <- paste(head(flip_data$flip_char, 10), collapse = "")
seq_text <- paste0("Flip Sequence = ", seq_preview, "...")
end_prop_text <- paste0("End Proportion = ", round(flip_data$running_prop[n_flips], 3))

# Plot using ggplot2 with logarithmic x-axis
ggplot(flip_data, aes(x = flip_num, y = running_prop)) +
  # Keep the reference horizontal dashed line at y = 0.5
  geom_hline(yintercept = 0.5, linetype = "dotted", color = "black") +
  geom_line(color = "steelblue", alpha = 0.6) +
  geom_point(color = "steelblue", fill = "skyblue", shape = 21, size = 2) +
