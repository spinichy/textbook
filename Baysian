# Load required libraries
library(ggplot2)
library(gridExtra)

# Set seed for reproducibility
set.seed(123)

# ==========================================
# 1. Simulation Setup (Pinochle Deck)
# ==========================================
# 48 cards total: 8 cards for each rank (9, 10, Jack, Queen, King, Ace)
deck <- c(rep("9", 8), rep("10", 8), rep("Jack", 8), 
          rep("Queen", 8), rep("King", 8), rep("Ace", 8))

N <- 2000  # Total number of empirical draws (with replacement)
draws <- sample(deck, size = N, replace = TRUE)

# Mathematical (Theoretical) Probabilities
true_p_10 <- 8 / 48              # 1/6 = 0.1667
true_p_10_or_jack <- 16 / 48     # 1/3 = 0.3333

# Empirical Running Proportions
emp_p_10 <- cumsum(draws == "10") / (1:N)
emp_p_10_or_jack <- cumsum(draws %in% c("10", "Jack")) / (1:N)

df_sim <- data.frame(
  Draw = 1:N,
  Empirical_10 = emp_p_10,
  Empirical_10_Jack = emp_p_10_or_jack
)


# ==========================================
# 2. Plot (A): P(10) Empirical vs Theoretical
# ==========================================
p1 <- ggplot(df_sim, aes(x = Draw, y = Empirical_10)) +
  # Empirical running proportion line in BLACK
  geom_line(color = "black", linewidth = 1) +
  # Theoretical value reference line in GRAY (dashed)
  geom_hline(yintercept = true_p_10, color = "gray50", linetype = "dashed", linewidth = 1.1) +
  # Annotate theoretical value
  annotate("label", x = N * 0.75, y = true_p_10 + 0.05, 
           label = paste0("Theoretical P(10) = 8/48 ≈ ", round(true_p_10, 4)),
           color = "gray30", fill = "white", fontface = "bold", size = 3.8) +
  # Annotate final empirical estimate
  annotate("label", x = N * 0.75, y = tail(emp_p_10, 1) - 0.05, 
           label = paste0("Empirical (N=", N, ") = ", round(tail(emp_p_10, 1), 4)),
           color = "black", fill = "white", fontface = "bold", size = 3.8) +
  scale_y_continuous(limits = c(0, 0.4), breaks = seq(0, 0.4, by = 0.1)) +
  labs(
    title = "(A) Probability of Drawing a 10",
    subtitle = "Empirical convergence vs. Theoretical exact value",
    x = "Number of Draws (N)",
    y = "Proportion"
  ) +
  theme_classic() +
  theme(
    plot.title = element_text(face = "bold", size = 13),
    axis.line = element_line(color = "black")
  )


# ==========================================
# 3. Plot (B): P(10 or Jack) Empirical vs Theoretical
# ==========================================
p2 <- ggplot(df_sim, aes(x = Draw, y = Empirical_10_Jack)) +
  # Empirical running proportion line in BLACK
  geom_line(color = "black", linewidth = 1) +
  # Theoretical value reference line in GRAY (dashed)
  geom_hline(yintercept = true_p_10_or_jack, color = "gray50", linetype = "dashed", linewidth = 1.1) +
  # Annotate theoretical value
  annotate("label", x = N * 0.75, y = true_p_10_or_jack + 0.05, 
           label = paste0("Theoretical P(10 or Jack) = 16/48 ≈ ", round(true_p_10_or_jack, 4)),
           color = "gray30", fill = "white", fontface = "bold", size = 3.8) +
